{
  "name": "status-groupp-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.8": "5.0.9",
    "fast-uri@3.1.4": "3.1.5",
    "js-yaml@4.3.0": "4.3.1",
    "nanoid@3.3.16": "3.3.18"
  },
  "type": "module"
}
